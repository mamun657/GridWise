# Production environment for the GridWise client.
#
# VITE_API_URL must point at the publicly reachable GridWise backend URL.
# Examples (pick one matching your actual deploy):
#   VITE_API_URL=https://gridwise-server.vercel.app
#   VITE_API_URL=https://api.gridwise.example.com
#
# In Vercel, set this under: Project Settings -> Environment Variables
#   Key:   VITE_API_URL
#   Value: https://your-backend-host
#   Scope: Production (and Preview if you want previews wired up too)
#
# Locally (`npm run dev`) the client falls back to http://localhost:4000.
VITE_API_URL=
